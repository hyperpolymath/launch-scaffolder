#
# ECOSYSTEM.a2ml — launch-scaffolder's position in the hyperpolymath ecosystem.

[metadata]
format          = "a2ml"
schema          = "ecosystem"
schema-version  = "0.1"
# ISO 8601 UTC timestamp (see STATE.a2ml for convention).
updated         = "2026-09-26T00:00:00Z"

[ecosystem]
version = "0.1"
name    = "launch-scaffolder"
type    = "cross-cutting-tool"
purpose = "Generate and maintain portable launcher scripts from a shared standard, with native Linux desktop provisioning."

position-in-ecosystem = """
launch-scaffolder is estate-wide tooling. It sits between the launcher
*standard* (maintained in the standards monorepo) and projects that need a
launcher. It produces scripts and manages Linux desktop entries; it is not a
runtime library. Native macOS and Windows provisioning remain unsupported.
"""

[[related-projects]]
name         = "standards"
repo         = "/var/mnt/eclipse/repos/developer-ecosystem/standards"
relationship = "standards-source"
detail       = "Hosts the canonical launcher-standard_praxis.deed at standards/launcher/launcher-standard_praxis.deed (and its prose counterpart at standards/docs/UX-standards/launcher-standard.adoc). launch-scaffolder reads the machine-readable form at runtime, resolving it via the :priority ladder the deed declares for itself."

[[related-projects]]
name         = "stapeln"
repo         = "/var/mnt/eclipse/repos/fleet-ecosystem/stapeln"
relationship = "reference-consumer"
detail       = "First real-world consumer. Its pre-2026-04-10 hand-written launcher at scripts/stapeln-launcher.sh was the template-porting source. Now scaffolder-managed via stapeln/stapeln.launcher.a2ml."

[[related-projects]]
name         = "aerie"
repo         = "/var/mnt/eclipse/repos/aerie"
relationship = "consumer"
detail       = "Process-kind launcher. First migration after stapeln."

[[related-projects]]
name         = "burble"
repo         = "/var/mnt/eclipse/repos/developer-ecosystem/burble"
relationship = "consumer"
detail       = "Server-url launcher (port 4020). Previous hand-written copy at scripts/burble-launcher.sh is deprecated-in-place pending removal."

[[related-projects]]
name         = "game-server-admin"
repo         = "/var/mnt/eclipse/repos/fleet-ecosystem/game-server-admin"
relationship = "consumer"
detail       = "Process-kind launcher. Wraps a pre-installed binary at ~/.local/bin/game-server-admin-launcher."

[[related-projects]]
name         = "nqc"
repo         = "/var/mnt/eclipse/repos/developer-ecosystem/nextgen-databases/nqc"
relationship = "consumer"
detail       = "Process-kind launcher inside the nextgen-databases monorepo. Launches the pre-installed ~/.bin/nqc binary with --gui."

[[related-projects]]
name         = "panll"
repo         = "/var/mnt/eclipse/repos/verification-ecosystem/panll"
relationship = "consumer"
detail       = "Server-url launcher (port 8000). PanLL may later consume launch-scaffolder as a *library* to offer a GUI minter."

[[related-projects]]
name         = "project-wharf"
repo         = "/var/mnt/eclipse/repos/project-wharf"
relationship = "consumer"
detail       = "Process-kind launcher."

[[related-projects]]
name         = "hyperpolymath-ecosystem"
relationship = "umbrella"
detail       = "Every hyperpolymath repo that ships a desktop launcher is a potential consumer. The 5 declared exceptions in docs/launcher-exceptions-2026-04-10.adoc are the current non-consumers and have explicit migration triggers."

[[related-projects]]
name         = "invariant-path"
repo         = "/var/mnt/eclipse/repos/verification-ecosystem/invariant-path"
relationship = "declared-exception"
detail       = "Stays hand-written — bespoke Rust CLI wrapper. Not a scaffolder consumer."

[[related-projects]]
name         = "hypatia"
repo         = "/var/mnt/eclipse/repos/verification-ecosystem/hypatia"
relationship = "declared-exception"
detail       = "Stays hand-written — remote web app with gossamer fallback and bespoke modes."

[integration-points]
input-config-format  = "TOML content under the legacy <repo-root>/<app>.launcher.a2ml filename; DEED migration is tracked with standards#960"
input-standard       = "Praxis DEED v1.0.0, launcher-standard_praxis.deed, located via the :priority search ladder declared under (resolution) -> standard-search"
output-launcher      = "Bash script at <repo-root>/<app>-launcher.sh (mode 0755 unless --no-chmod)"
output-desktop-entry = "Freedesktop .desktop files installed by the native Linux provisioner or generated-shell fallback"
output-bundle-macos  = "Not implemented; native macOS integration is planned"
output-shortcut-win  = "Not implemented; native Windows integration is planned"
